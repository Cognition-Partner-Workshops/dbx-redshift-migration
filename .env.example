# Redshift (operator-only, one-time golden capture)
REDSHIFT_HOST=your-workgroup.012345678901.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_USER=your-admin-user
REDSHIFT_PASSWORD=your-admin-password
REDSHIFT_DATABASE=mig_redshift_src
REDSHIFT_ADMIN_DATABASE=dev
REDSHIFT_WORKGROUP=your-workgroup

# Databricks (migration + validation sessions)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-token
# or: DATABRICKS_CONFIG_PROFILE=your-profile
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
MIG_CATALOG=mig_redshift_dev
