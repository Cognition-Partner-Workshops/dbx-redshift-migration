        core.stores AS s LEFT JOIN core.orders AS o ON o.store_id = s.store_id LEFT JOIN core.order_items AS oi
        ON oi.order_id = o.order_id
        GROUP BY GROUPING SETS ((s.region), (s.state), ())
    ORDER BY grouping_id NULLS LAST, s.region NULLS LAST, s.state NULLS LAST;
