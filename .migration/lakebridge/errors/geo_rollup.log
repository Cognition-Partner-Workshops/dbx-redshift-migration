EXPLAIN -- geo_rollup: GROUPING SETS over region / store state. grouping_id keeps the
-- key unique across NULL grouping columns (1 = region, 2 = state, 3 = total).
DROP TABLE IF EXISTS mart.geo_rollup;

CREATE
